 {% extends "__layout.twig" %}

{% block content %}
<ul class="nav nav-pills">
    <li class="nav-item">
        <a class="nav-link {{ active == 'image' ? 'active'}}" href="/{{ character }}/image">
            Picture
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link {{ active == 'info' ? 'active'}}" href="/{{ character }}/info">
            Info
        </a>
    </li>
</ul>

<ul class="list-group">
    <li class="list-group-item">
        {% block character_content %}
            Choose a category
        {% endblock %}
    </li>
</ul>



{% endblock %}