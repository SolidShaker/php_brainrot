{% extends "__layout.twig" %}

{% block content %}

<div style="display: flex; flex-direction: row; flex-wrap: wrap; justify-content: flex-start; gap: 20px;">

    {% for character in characters %}

        <div 
            style="width: 18rem; position: relative; display: flex; flex-direction: column; justify-content: center; overflow: hidden; border: 0.1rem solid rgb(188, 187, 187); border-radius: 0.8rem;"
        >
            <div
                class="position-absolute"
                style="right: 6px; top: 6px; display: flex; flex-direction: column; gap: 5px; align-items: center;"
            >
                <form
                    action="/characters/{{ character.id }}/delete"
                    method="POST"
                    onsubmit="return confirm('Are you sure you want to delete this character?');"
                >
                    <button type="submit" class="btn btn-danger btn-sm"
                            style="width: 32px; height: 32px; padding: 0;">
                        <i class="fas fa-times"></i>
                    </button>
                </form>

                <form action="/characters/{{ character.id }}/edit" method="GET">
                    <button type="submit" class="btn btn-warning btn-sm"
                            style="width: 32px; height: 32px; padding: 0;">
                        <i class="fas fa-edit"></i>
                    </button>
                </form>
            </div>


            <a class="nav-link text-white p-0" aria-current="page" href="/characters/{{ character.id }}">
                <img src="{{ character.image }}" style="width: 100%; aspect-ratio: 1; object-fit: cover;" />
            </a>
            
            <button type="button" class="btn btn-primary mb-2" style="border-radius: 0px;">
                <a class="nav-link text-white p-0" aria-current="page" href="/characters/{{ character.id }}">{{ character.title }}</a>
            </button>
            <button type="button" class="btn btn-link p-1">
                <a class="nav-link active p-0" aria-current="page" href="/characters/{{ character.id }}?show=image">Picture</a>
            </button>
            <button type="button" class="btn btn-link p-1">
                <a class="nav-link active p-0" aria-current="page" href="/characters/{{ character.id }}?show=info">Info</a>
            </button>
        </div>

    {% endfor %}
    
</div>

{% endblock %}
