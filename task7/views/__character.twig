{% extends "__layout.twig" %}


{% block content %}
    <div>
        {{title}}
    </div>

    <ul class="nav nav-pills">
        {% for item in menu %}
            {% if item.title == title %}
                <li class="nav-item">
                    <a class="nav-link {{ active == 'image' ? 'active' }}" 
                       href="{{ item.image }}"
                    >
                        Picture
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ active == 'info' ? 'active' }}" 
                       href="{{ item.info }}"
                    >
                        Info
                    </a>
                </li>
            {% endif %}
        {% endfor %}
    </ul>


    <ul class="list-group">
        <li class="list-group-item">
        {% block category %}
            Choose your category
        {% endblock%}
        </li>
    </ul>
{% endblock %}