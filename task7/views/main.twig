{% extends "__layout.twig" %}




{% block content %}
    <ul class="list-group">
        {% for item in menu %}
            {% if item.title != "Home" %}
            <li class="list-group-item">
                <button type="button" class="btn btn-primary">
                    <a class="nav-link active" aria-current="page" href="{{item.url}}">{{item.title}}</a>
                </button>
                <button type="button" class="btn btn-link">
                    <a class="nav-link active" aria-current="page" href="{{item.image}}">Picture</a>
                </button>
                <button type="button" class="btn btn-link">
                    <a class="nav-link active" aria-current="page" href="{{item.info}}">Info</a>
                </button>
            </li>
            {% endif %}
        {% endfor %}
    </ul>
{% endblock %}